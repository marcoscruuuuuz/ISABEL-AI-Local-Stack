# ============================================================
# ISABEL AI Local Stack - Environment
# ============================================================
STACK_NAME=isabel-ai
TZ=America/Sao_Paulo
ISABEL_VERSION=1.0.2

# Rede
LAN_BIND=0.0.0.0
GATEWAY_PORT=8088
WEBUI_PORT=3000
ADMIN_PORT=3001
QDRANT_PORT=6333
SGLANG_PORT=30000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Hardware / Inferência
CUDA_VISIBLE_DEVICES=0
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
EMBED_MODEL=BAAI/bge-m3
MAX_MODEL_LEN=8192
MEM_FRACTION_STATIC=0.85
TP_SIZE=1

# Paths
MODELS_DIR=/opt/isabel/models
CORPUS_DIR=/opt/isabel/corpus
DATA_DIR=/opt/isabel/data
WORKSPACE_DIR=/opt/isabel/data/workspace

# Segurança Agent
AGENT_MODE=sandbox
AGENT_ROOT=/opt/isabel/data/workspace
ALLOW_SHELL=false
ALLOW_NETWORK_FROM_AGENT=false
MAX_EDIT_BYTES=2000000

# Auth
API_TOKEN=troque-este-token-muito-forte-aqui
WEBUI_SECRET=troque-esta-chave-secreta
JWT_SECRET=outra-chave-jwt-forte-aqui
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha

# PostgreSQL
POSTGRES_DB=isabel
POSTGRES_USER=isabel
POSTGRES_PASSWORD=troque-postgres-password

# Redis
REDIS_URL=redis://redis:6379/0

# Deep Research
RESEARCH_MAX_LOOPS=6
RESEARCH_TOP_K=12

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_HOSTNAME=ai.seudominio.com.br
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Comercial
DEFAULT_PLAN=starter
TOKEN_PRICE_PER_1K=0.02
MONTHLY_TOKEN_QUOTA_STARTER=500000
MONTHLY_TOKEN_QUOTA_PRO=2000000
MONTHLY_TOKEN_QUOTA_ENTERPRISE=10000000
